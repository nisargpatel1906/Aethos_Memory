# Aethos Memory MCP Server — Environment Variables
# Copy this to .env and fill in your values, or set these directly in your
# MCP client config (recommended — see README.md for the JSON snippet format).
# Never commit this file with real values to version control.

# ── Supabase ────────────────────────────────────────────────────────────────
# Your Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Service role key — bypasses Row Level Security. Keep this secret.
# Find in: Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJh...your-service-role-key

# ── LLM providers (extraction) ──────────────────────────────────────────────
# Primary extraction provider (fast, generous free tier)
GROQ_API_KEY=gsk_...your-groq-key

# Fallback extraction provider (used if Groq is rate-limited or unavailable)
OPENROUTER_API_KEY=sk-or-...your-openrouter-key

# ── Embeddings ───────────────────────────────────────────────────────────────
# Sole embedding provider — gemini-embedding-001 at 768 dimensions.
# No fallback is used here by design (see docs/tech-stack.md).
GEMINI_API_KEY=AIzaSy...your-gemini-key

# ── Identity & project scope ─────────────────────────────────────────────────
# Your Supabase auth.users UUID — identifies which user's memories to read/write.
# Find this in your Supabase Dashboard → Authentication → Users, or from the
# dashboard's Settings page (auto-filled from your active session).
AETHOS_USER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Project tag for this MCP client config. Memories written by this client are
# scoped to this tag. Use "global" for cross-project memories.
AETHOS_PROJECT=global

# Label stored with each memory to identify which AI tool created it.
# Set this differently in each MCP client config to track memory origins.
# Examples: Claude Code, Cursor, Windsurf, OpenCode, Antigravity
AETHOS_SOURCE_TOOL=MCP Client
