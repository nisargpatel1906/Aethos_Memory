# Aethos Memory Dashboard — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# ── Supabase (public — safe to expose to the browser) ──────────────────────
# Your Supabase project URL (find in: Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key (find in: Project Settings → API → anon public)
# This key is safe to ship in browser code — RLS policies enforce access control.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJh...your-anon-key

# ── Gemini (server-side only — NEVER prefix with NEXT_PUBLIC_) ──────────────
# Used exclusively in app/api/reembed/route.ts (serverless function).
# Never exposed to the browser. Set this in Vercel's Environment Variables UI.
GEMINI_API_KEY=AIzaSy...your-gemini-key
